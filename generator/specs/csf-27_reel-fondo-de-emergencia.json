\" data-a=\"pop\"/><rect x=\"294\" y=\"336\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.196\" data-a=\"pop\"/><rect x=\"336\" y=\"336\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.204\" data-a=\"pop\"/><rect x=\"378\" y=\"336\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.212\" data-a=\"pop\"/><rect x=\"0\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.220\" data-a=\"pop\"/><rect x=\"42\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.228\" data-a=\"pop\"/><rect x=\"84\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.236\" data-a=\"pop\"/><rect x=\"126\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.244\" data-a=\"pop\"/><rect x=\"168\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.252\" data-a=\"pop\"/><rect x=\"210\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.260\" data-a=\"pop\"/><rect x=\"252\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.268\" data-a=\"pop\"/><rect x=\"294\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.276\" data-a=\"pop\"/><rect x=\"336\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.284\" data-a=\"pop\"/><rect x=\"378\" y=\"378\" width=\"34\" height=\"34\" rx=\"6\" fill=\"#2a2a2a\" data-in=\"1.292\" data-a=\"pop\"/></g><text x=\"470\" y=\"150\" fill=\"#F4C542\" font-size=\"96\" font-weight=\"800\" text-anchor=\"start\" data-in=\"0.6\" data-a=\"fade\">36,4 %</text><text x=\"470\" y=\"215\" fill=\"#CFCFCA\" font-size=\"34\" font-weight=\"600\" text-anchor=\"start\" data-in=\"0.8\" data-a=\"fade\">no puede afrontar</text><text x=\"470\" y=\"260\" fill=\"#CFCFCA\" font-size=\"34\" font-weight=\"600\" text-anchor=\"start\" data-in=\"0.8\" data-a=\"fade\">gastos imprevistos</text></svg><div class=\"src\" data-in=\"1.6\" data-a=\"fade\">Fuente: INE, Encuesta de Condiciones de Vida 2025 (publicada el 05/02/2026). En 2024: 35,8 %.</div></div>"
