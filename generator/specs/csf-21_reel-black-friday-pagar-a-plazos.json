.2\" data-a=\"fade\"/><rect x=\"600\" y=\"192.5\" width=\"190\" height=\"100.0\" fill=\"#F4C542\" data-in=\"1.2\" data-a=\"fade\"/><rect x=\"600\" y=\"130.0\" width=\"190\" height=\"62.5\" fill=\"#2a2a2a\" stroke=\"#CFCFCA\" stroke-width=\"2\" data-in=\"1.2\" data-a=\"fade\"/><text x=\"695\" y=\"114.0\" fill=\"#F5F5F2\" font-size=\"44\" font-weight=\"800\" text-anchor=\"middle\" data-in=\"1.5\" data-a=\"fade\">200 €</text><text x=\"695\" y=\"425\" fill=\"#CFCFCA\" font-size=\"32\" font-weight=\"600\" text-anchor=\"middle\" data-in=\"1.2\" data-a=\"fade\">Mes 3</text><rect x=\"0\" y=\"470\" width=\"26\" height=\"26\" fill=\"#F5F5F2\" stroke=\"#6F6F6F\" stroke-width=\"2\" data-in=\"1.6\" data-a=\"fade\"/><text x=\"40\" y=\"492\" fill=\"#CFCFCA\" font-size=\"30\" font-weight=\"600\" text-anchor=\"start\" data-in=\"1.6\" data-a=\"fade\">Abrigo 120 €</text><rect x=\"430\" y=\"470\" width=\"26\" height=\"26\" fill=\"#6F6F6F\" stroke=\"#6F6F6F\" stroke-width=\"2\" data-in=\"1.6\" data-a=\"fade\"/><text x=\"470\" y=\"492\" fill=\"#CFCFCA\" font-size=\"30\" font-weight=\"600\" text-anchor=\"start\" data-in=\"1.6\" data-a=\"fade\">Auriculares 90 €</text><rect x=\"0\" y=\"520\" width=\"26\" height=\"26\" fill=\"#F4C542\" stroke=\"#6F6F6F\" stroke-width=\"2\" data-in=\"1.6\" data-a=\"fade\"/><text x=\"40\" y=\"542\" fill=\"#CFCFCA\" font-size=\"30\" font-weight=\"600\" text-anchor=\"start\" data-in=\"1.6\" data-a=\"fade\">Móvil 240 €</text><rect x=\"430\" y=\"520\" width=\"26\" height=\"26\" fill=\"#2a2a2a\" stroke=\"#6F6F6F\" stroke-width=\"2\" data-in=\"1.6\" data-a=\"fade\"/><text x=\"470\" y=\"542\" fill=\"#CFCFCA\" font-size=\"30\" font-weight=\"600\" text-anchor=\"start\" data-in=\"1.6\" data-a=\"fade\">Zapatillas 150 €</text></svg><div class=\"src\" data-in=\"1.9\" data-a=\"fade\">Ejemplo ilustrativo, cálculo propio: compras por 600 € en 3 plazos = 200 € al mes.</div></div>"
